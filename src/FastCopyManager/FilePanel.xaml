<UserControl x:Class="FastCopyManager.FilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ComboBox DockPanel.Dock="Top" x:Name="DriveBox" SelectionChanged="DriveBox_SelectionChanged"/>
        <TextBlock DockPanel.Dock="Top" x:Name="PathText" Padding="4,2" Background="#FF1E3A8A" Foreground="White"
                   TextTrimming="CharacterEllipsis"/>
        <ListView x:Name="List" SelectionMode="Extended" FontFamily="Consolas"
                  MouseDoubleClick="List_MouseDoubleClick" PreviewKeyDown="List_PreviewKeyDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Název" Width="230" DisplayMemberBinding="{Binding Display}"/>
                    <GridViewColumn Header="Velikost" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Změněno" Width="120" DisplayMemberBinding="{Binding DateText}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
