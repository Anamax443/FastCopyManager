<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FastCopyManager</AssemblyName>
    <Version>0.1.0</Version>
    <Company>AXIMA</Company>
    <Product>FastCopyManager</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\MxPlus_IBM_VGA_8x16.ttf" />
  </ItemGroup>

  <!-- 7za.exe (7-Zip Extra) a jeho licence: zabudované v aplikaci, aby stačil jediný exe na flashce -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\third_party\7-Zip\7za.exe" LogicalName="7za.exe" />
    <EmbeddedResource Include="..\..\third_party\7-Zip\License.txt" LogicalName="7-Zip-License.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

</Project>
