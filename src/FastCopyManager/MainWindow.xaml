<Window x:Class="FastCopyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastCopyManager"
        Title="FastCopyManager" Height="560" Width="980" MinWidth="700"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <local:FilePanel x:Name="LeftPanel" Grid.Row="0" Grid.Column="0" Margin="4,4,2,4"/>
        <local:FilePanel x:Name="RightPanel" Grid.Row="0" Grid.Column="1" Margin="2,4,4,4"/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="StatusText" Padding="6,2" Text="Připraveno"/>

        <UniformGrid Grid.Row="2" Grid.ColumnSpan="2" Rows="1" Margin="4">
            <Button Content="F5 Kopírovat" Click="Copy_Click" Focusable="False"/>
            <Button Content="F6 Přesunout" Click="Move_Click" Focusable="False"/>
            <Button Content="F7 Nová složka" Click="MkDir_Click" Focusable="False"/>
            <Button Content="F8 Smazat" Click="Delete_Click" Focusable="False"/>
            <Button Content="Tab Přepnout" Click="Switch_Click" Focusable="False"/>
            <Button Content="F10 Konec" Click="Exit_Click" Focusable="False"/>
        </UniformGrid>
    </Grid>
</Window>
