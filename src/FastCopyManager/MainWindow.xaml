<Window x:Class="FastCopyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastCopyManager"
        Title="FastCopyManager" Height="600" Width="1000" MinWidth="760"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Background="#FF0000AA" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased"
        FontFamily="/FastCopyManager;component/Fonts/#MxPlus IBM VGA 8x16, Consolas" FontSize="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- horní menu: hotkey písmena žlutě, rozbalovací seznam řeší MainWindow.xaml.cs -->
        <Border x:Name="MenuBarBorder" Grid.Row="0" Grid.ColumnSpan="2" Background="#FF00AAAA" Padding="8,1">
            <StackPanel x:Name="MenuBar" Orientation="Horizontal"/>
        </Border>
        <Popup x:Name="MenuPopup" Grid.Row="0" Placement="Bottom" StaysOpen="True" Closed="MenuPopup_Closed"/>

        <local:FilePanel x:Name="LeftPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,1,0"/>
        <local:FilePanel x:Name="RightPanel" Grid.Row="1" Grid.Column="1" Margin="1,0,0,0"/>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="4,0">
            <TextBlock DockPanel.Dock="Top" x:Name="QueueText" Visibility="Collapsed" Foreground="#FFFFFF55"
                       TextTrimming="CharacterEllipsis" Margin="2,2,2,2"/>
            <CheckBox DockPanel.Dock="Right" x:Name="VerifyBox" Content="Ověřit hashem" IsChecked="True"
                      Foreground="#FF55FFFF" VerticalAlignment="Center" Focusable="False"/>
            <TextBlock x:Name="StatusText" Padding="2" Text="Připraveno" TextTrimming="CharacterEllipsis"
                       Foreground="#FF55FFFF"/>
        </DockPanel>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock x:Name="PromptText" Padding="4,0,0,0" Foreground="#FFE8E8E8" VerticalAlignment="Center"/>
            <TextBox x:Name="CommandBox" Background="Transparent" Foreground="#FFE8E8E8" CaretBrush="White"
                     BorderThickness="0" Padding="0" VerticalAlignment="Center"/>
        </DockPanel>

        <UniformGrid Grid.Row="4" Grid.ColumnSpan="2" x:Name="FKeyBar" Rows="1"/>
    </Grid>
</Window>
